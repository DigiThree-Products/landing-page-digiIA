# Copie para .env.local ou configure no ambiente de deploy.
# NEXT_PUBLIC_* nunca é segredo: o valor vai para o navegador.

# Endereço canônico do site.
# NEXT_PUBLIC_SITE_URL=https://landing-page-digi-ia.vercel.app

# Supabase público. A RLS versionada em supabase/migrations permite só INSERT.
# NEXT_PUBLIC_SUPABASE_URL=https://serhbkigjqicuckjnudl.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Checkout. Vazio mantém a página somente como lista de espera.
# NEXT_PUBLIC_KIWIFY_CHECKOUT=https://pay.kiwify.com.br/xxxxxxx

# Medição. Ao ativar, a política de privacidade gerada passa a declarar o uso.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# Vídeo: youtube, vimeo ou arquivo. Poster pode ser um caminho em public/.
# NEXT_PUBLIC_VIDEO_TYPE=youtube
# NEXT_PUBLIC_VIDEO_ID=
# NEXT_PUBLIC_VIDEO_POSTER=/assets/video/poster.webp

# Identificação do controlador. Obrigatória antes de publicar páginas legais.
# NEXT_PUBLIC_LEGAL_NAME=Razão Social Ltda.
# NEXT_PUBLIC_LEGAL_CNPJ=00.000.000/0001-00
# NEXT_PUBLIC_LEGAL_EMAIL=privacidade@empresa.com.br
# NEXT_PUBLIC_LEGAL_CITY_STATE=Angra dos Reis/RJ
